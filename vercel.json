{
  "alias": ["financiallysovereign.academy"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.financiallysovereign.academy"
        }
      ],
      "destination": "https://financiallysovereign.academy/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/institutional/corporations/colombia",
      "destination": "https://bitcoinsovereign.academy/institutional/corporations/colombia/"
    },
    {
      "source": "/institutional/corporations/colombia/",
      "destination": "https://bitcoinsovereign.academy/institutional/corporations/colombia/"
    },
    {
      "source": "/institutional/corporations/colombia/ruta-estabilidad-crecimiento",
      "destination": "https://bitcoinsovereign.academy/programa-colombia/"
    },
    {
      "source": "/institutional/corporations/colombia/ruta-estabilidad-crecimiento/",
      "destination": "https://bitcoinsovereign.academy/programa-colombia/"
    },
    {
      "source": "/institutional/corporations/colombia/ruta-estabilidad-crecimiento/:path*",
      "destination": "https://bitcoinsovereign.academy/programa-colombia/"
    },
    {
      "source": "/institutional/corporations/colombia/:path*",
      "destination": "https://bitcoinsovereign.academy/institutional/corporations/colombia/:path*"
    },
    {
      "source": "/institutional/wealth-advisors/bitcoin-advisor-certification",
      "destination": "https://bitcoinsovereign.academy/institutional/wealth-advisors/bitcoin-advisor-certification/"
    },
    {
      "source": "/institutional/wealth-advisors/bitcoin-advisor-certification/",
      "destination": "https://bitcoinsovereign.academy/institutional/wealth-advisors/bitcoin-advisor-certification/"
    },
    {
      "source": "/institutional/wealth-advisors/bitcoin-advisor-certification/:path*",
      "destination": "https://bitcoinsovereign.academy/institutional/wealth-advisors/bitcoin-advisor-certification/:path*"
    },
    {
      "source": "/institutional",
      "destination": "/institutional/index.html"
    },
    {
      "source": "/institutional/",
      "destination": "/institutional/index.html"
    },
    {
      "source": "/institutional/:page",
      "destination": "/institutional/:page.html"
    },
    {
      "source": "/institutional/:page/",
      "destination": "/institutional/:page.html"
    }
  ]
}
